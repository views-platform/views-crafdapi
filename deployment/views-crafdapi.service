# The systemd service for the CRAF'd forecast API.
#
# It runs as the service account. Every start first runs the deploy gate
# (scripts/checkout-deploy-tag.sh), so what serves is always the tag named in
# ~/.views-crafdapi-deploy-tag. How to release, restart and read the log:
# deployment/RELEASE_RUNBOOK.md.

[Unit]
Description=VIEWS CRAF'd Conflict Forecast API
After=network-online.target
Wants=network-online.target

# Stop retrying after 30 failed starts in 10 minutes (about 3.5 minutes of retrying). Then the
# service shows `failed` instead of retrying a bad tag forever. These two lines must stay under
# [Unit]: systemd ignores them under [Service].
StartLimitIntervalSec=600
StartLimitBurst=30

[Service]
Type=exec
User=views-crafdapi-deploy
WorkingDirectory=/home/views-crafdapi-deploy/views-crafdapi
EnvironmentFile=/home/views-crafdapi-deploy/.env.crafdapi
ExecStartPre=/usr/bin/env bash /home/views-crafdapi-deploy/views-crafdapi/scripts/checkout-deploy-tag.sh
ExecStart=/home/views-crafdapi-deploy/views-crafdapi/.venv/bin/uvicorn \
    views_crafdapi.managers.api:create_app \
    --factory --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5

# A start that hangs (for example fetching tags) counts as failed after 3 minutes. A normal start
# takes about 3 seconds.
TimeoutStartSec=180

# Memory. The service runs alone on a 32 GB server. Its highest use is at start, when it reads the
# forecast: 7.3 GB, measured 2026-08-21 on v0.5.1. If it goes above 24 GB, it is stopped and
# systemd restarts it; about 8 GB stay free for the system, so the server stays reachable. There
# is deliberately no softer limit (MemoryHigh): without swap it slows the service to a crawl
# while it still looks running, and nothing restarts it. MemorySwapMax=0 keeps the limit exact
# even if swap is added later. (Independent review, 2026-11-18.)
MemoryMax=24G
MemorySwapMax=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=views-crafdapi

[Install]
WantedBy=multi-user.target
