# The production systemd unit for the FAO Forecast API (epic #184, S3+S4).
#
# Replaces the interim unit from the 2026-06-29 outage recovery (which ran from a
# personal account). This one runs as the dedicated service account, and every
# start passes the deploy gate (checkout-deploy-tag.sh), so what serves is always
# exactly the tag named in ~/.views-faoapi-deploy-tag.
#
# Install:  sudo cp deployment/views-faoapi.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now views-faoapi
# Logs:     sudo journalctl -u views-faoapi -f
# Deploy:   echo vX.Y.Z > ~views-faoapi-deploy/.views-faoapi-deploy-tag
#           sudo systemctl restart views-faoapi

[Unit]
Description=VIEWS FAO Conflict Forecast API
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=views-faoapi-deploy
WorkingDirectory=/home/views-faoapi-deploy/views-faoapi
EnvironmentFile=/home/views-faoapi-deploy/.env.faoapi
ExecStartPre=/usr/bin/env bash /home/views-faoapi-deploy/views-faoapi/scripts/checkout-deploy-tag.sh
ExecStart=/home/views-faoapi-deploy/views-faoapi/.venv/bin/uvicorn \
    views_crafdapi.managers.api:create_app \
    --factory --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=views-faoapi

[Install]
WantedBy=multi-user.target
